<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/surface"
    android:layout_marginBottom="12dp"
    android:padding="12dp">

    <!-- 상단: 썸네일 + 제목 + 상태 + 태그 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <!-- 썸네일 영역 -->
        <FrameLayout
            android:layout_width="110dp"
            android:layout_height="80dp"
            android:background="@color/surface_variant"
            android:layout_marginEnd="12dp">

            <ImageView
                android:id="@+id/ivThumbnail"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop" />

            <TextView
                android:id="@+id/tvDuration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|end"
                android:background="#B3000000"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:text="00:00"
                android:textColor="#FFFFFF"
                android:textSize="11sp" />
        </FrameLayout>

        <!-- 정보 영역 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- 파일명 -->
            <TextView
                android:id="@+id/tvFileName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Screen_Recording.mp4"
                android:textColor="@color/on_surface"
                android:textSize="15sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:ellipsize="middle" />

            <!-- 상태 배지 -->
            <TextView
                android:id="@+id/tvBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@color/badge_cached"
                android:textColor="@color/badge_cached_text"
                android:text="✅ 기존 분석 완료"
                android:textSize="11sp"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:layout_marginTop="3dp"
                android:layout_marginBottom="4dp" />

            <!-- 태그 목록 -->
            <TextView
                android:id="@+id/tvTags"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="#베드로의고백처럼 #예수님사랑"
                android:textColor="@color/tag_text"
                android:textSize="13sp"
                android:textStyle="bold"
                android:maxLines="2"
                android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>

    <!-- 하단 실행 버튼 2개 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="10dp">

        <Button
            android:id="@+id/btnPlayInApp"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:text="📱 바로 재생"
            android:textSize="12sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="@color/primary"
            android:layout_marginEnd="4dp" />

        <Button
            android:id="@+id/btnPlaySamsung"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:text="▶️ 삼성 비디오"
            android:textSize="12sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="@color/samsung_blue"
            android:layout_marginStart="4dp" />
    </LinearLayout>

</LinearLayout>
