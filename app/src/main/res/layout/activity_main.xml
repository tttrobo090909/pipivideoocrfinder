<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0F1411"
    android:padding="16dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="16dp">

        <TextView
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="#22C55E"
            android:text="ㅍ"
            android:textColor="#052E16"
            android:textSize="22sp"
            android:textStyle="bold"
            android:gravity="center" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="피피비디오OCR파인더 (ML Kit)"
                android:textColor="#F0FDF4"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="오프라인 온디바이스 구글 AI 탑재"
                android:textColor="#86EFAC"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- File Select Button -->
    <LinearLayout
        android:id="@+id/btnSelectVideos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#18201A"
        android:padding="16dp"
        android:gravity="center">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📂 동영상 파일 선택하기"
            android:textColor="#F0FDF4"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="스마트폰 저장소에서 영상들을 다중 선택하세요"
            android:textColor="#94A3B8"
            android:textSize="12sp"
            android:layout_marginTop="4dp" />
    </LinearLayout>

    <Button
        android:id="@+id/btnStartAnalyze"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="⚡ ML Kit 분석 시작하기"
        android:backgroundTint="#22C55E"
        android:textColor="#052E16"
        android:textStyle="bold"
        android:layout_marginTop="10dp"
        android:enabled="false" />

    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvProgress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#86EFAC"
        android:textSize="12sp"
        android:gravity="end"
        android:visibility="gone" />

    <!-- Search Input -->
    <EditText
        android:id="@+id/etSearch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="🔍 찾고 싶은 한글 자막 입력..."
        android:textColorHint="#94A3B8"
        android:textColor="#F0FDF4"
        android:background="#212C24"
        android:padding="14dp"
        android:layout_marginTop="16dp" />

    <TextView
        android:id="@+id/tvResultCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#86EFAC"
        android:textSize="13sp"
        android:layout_marginTop="12dp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvResults"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp" />

</LinearLayout>
